{
  "name": "anxiety-attack-detector",
  "version": "1.0.0",
  "private": true,
  "main": "backend/src/server.js",
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install",
    "dev": "node scripts/dev.js",
    "client": "npm --prefix frontend run dev",
    "server": "node backend/src/server.js",
    "server:dev": "nodemon backend/src/server.js",
    "ml": "python -m uvicorn app.main:app --app-dir ml-engine --host 0.0.0.0 --port 8000",
    "test": "npm run test:server",
    "test:server": "node --test backend/src/tests/*.test.js",
    "check:server": "node scripts/check-server.js",
    "test:client": "npm --prefix frontend run lint",
    "test:ml": "cd ml-engine && python -m pytest tests",
    "lint": "npm --prefix frontend run lint",
    "build": "npm --prefix frontend run build",
    "build:pages": "npm --prefix frontend run build:pages",
    "clean": "node scripts/clean.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParthGadekar0631/Anxiety-Attack_Detector.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ParthGadekar0631/Anxiety-Attack_Detector/issues"
  },
  "homepage": "https://github.com/ParthGadekar0631/Anxiety-Attack_Detector#readme",
  "description": "AI-assisted anxiety escalation detection and intervention platform with mock AI/SMS, wearable simulation, voice trigger, and relapse risk.",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
